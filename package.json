{
	"name": "cool-admin-react",
	"version": "8.0.0",
	"description": "cool-admin React + AntD 管理端前端（协议与 cool-admin-nest 100% 兼容，可插拔替换 Vue 版）",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --host",
		"eps": "node scripts/gen-eps.mjs",
		"build": "node scripts/gen-eps.mjs && tsc -b && vite build",
		"preview": "vite preview",
		"type-check": "tsc -b --force",
		"lint": "eslint . --fix",
		"format": "prettier --write src/"
	},
	"dependencies": {
		"@ant-design/icons": "^6.0.0",
		"@wangeditor/editor": "^5.1.23",
		"@wangeditor/editor-for-react": "^1.0.6",
		"antd": "^5.27.0",
		"axios": "^1.7.9",
		"dayjs": "^1.11.13",
		"echarts": "^5.6.0",
		"echarts-for-react": "^3.0.2",
		"i18next": "^24.2.0",
		"nprogress": "^0.2.0",
		"react": "^18.3.1",
		"react-activation": "^0.13.4",
		"react-dom": "^18.3.1",
		"react-i18next": "^15.4.0",
		"react-router-dom": "^6.28.0",
		"zustand": "^5.0.2"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"@types/nprogress": "^0.2.3",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"sass-embedded": "^1.102.0",
		"typescript": "~5.6.3",
		"vite": "^6.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"@parcel/watcher"
		]
	}
}
